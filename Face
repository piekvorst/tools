#!/usr/bin/env rc
ifs = '
'

. 9.rc
. lib.rc
. $PLAN9/lib/acme.rc
. libacme.rc

if (! ~ $1 '') {
	if (! test -r $1) {
		echo >[1=2] not a file: $1
		exit io
	}

	winctl font $1
	exit
}

parsectl ctl

switch ($ctl($acmectlfont)) {
case `{varfont}; winctl font `{fixfont}
case `{fixfont}; winctl font `{varfont}
case *; winctl font `{varfont}
}

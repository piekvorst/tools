#!/usr/bin/env rc
flag e +
ifs = '
'

# git show master:`{gitname $%}

if (~ $1 '') {
	echo >[1=2] name not given
	exit 1
}

if (! git rev-parse --is-inside-work-tree >/dev/null) {
	echo >[1=2] not inside a git work tree
	exit 1
}

cutprefix `{git rev-parse --show-toplevel}/ `{cleanname -d `{pwd} $1}

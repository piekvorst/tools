#!/usr/bin/env rc
ifs = '
'

. 9.rc
. lib.rc

progname = `{basename $0}

jobs = 4

tmpdir = /tmp/$progname$pid
mkdir -p $tmpdir

error = $tmpdir/error
touch $error

mu = $tmpdir/mu
touch $mu

if (~ $* '') {
	echo_s >[1=2] $progname: no file
	exit 1
}

for (f in $*) {
	if (! test -f $f) {
		echo_s >[1=2] $progname: not a file: $f
		exit 1
	}
	if (! test -r $f) {
		echo_s >[1=2] $progname: not readable: $f
		exit 1
	}
}

mkdir -p $tmpdir

previews = ()

for (i in `{seq -f '%03g' $#*}) {
	previews = ($previews $tmpdir/`{basename $*($i)}-$i.html)

	{
		{
			flock 3
			if (! ~ `{cat $error} '')
				exit 1
		} >[3]$mu

		if (! pandoc --standalone -o $previews($#previews) $*($i)) {
			{
				flock 3
				echo_s failed to make a preview: $*($i) >$error
			} >[3]$mu
			exit 1
		}
	} &
	wgadd wg $jobs
}

wgwait wg

if (! ~ `{cat $error} '') {
	echo_s >[1=2] $progname: `{cat $error}
	exit 1
}

web $previews

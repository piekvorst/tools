#!/usr/bin/env rc
ifs = '
'

. 9.rc
. $PLAN9/lib/acme.rc
. lib.rc
. libacme.rc

nl = '
'

fs = '
	 '

progname = `{basename $0}

tmpdir = /tmp/$progname$pid
mkdir -p $tmpdir

parentwinid = $winid
winid = '' # be explicit in multi-window context

fn sigexit {rm -r $tmpdir}

fn event {
	# $1 - c1 origin of event
	# $2 - c2 type of action
	# $3 - q0 beginning of selection
	# $4 - q1 end of selection
	# $5 - eq0 beginning of expanded selection
	# $6 - eq1 end of expanded selection
	# $7 - flag
	# $8 - nr number of runes in $9
	# $9 - text
	# $10 - chorded argument
	# $11 - origin of chorded argument

	switch($1$2){
	case E*	# write to body or tag
	case F*	# generated by ourselves; ignore
	case K*	# type away we do not care
	case Mi	# mouse: text inserted in tag
	case MI	# mouse: text inserted in body
	case Md	# mouse: text deleted from tag
	case MD	# mouse: text deleted from body

	case Mx MX	# button 2 in tag or body
		switch ($9) {
		case Get
			get

		case Pick
			pick

		case Skip
			skip

		case *
			winid = $filterwinid {
				winwriteevent $*
			}
		}

	case Ml ML	# button 3 in tag or body
		winid = $filterwinid {
			winwriteevent $*
		}
	}
}

fn get {@ {
	newbody = $tmpdir/newbody
	currentbody = $tmpdir/currentbody

	winid = $parentwinid {
		winread body >$newbody
		parentaddr = `$fs{acmeaddr}

		# FIXME: move this to acmeaddr
		#
		if (~ $#parentaddr 1)
			parentaddr = ($parentaddr $parentaddr)
	}

	winid = $filterwinid {
		winread body >$currentbody
	}

	if (! cmp -s $currentbody $newbody) {
		winid = $filterwinid {
			oldname = `{winname}
			winctl name $newbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			winaddr '#'$parentaddr(1)',#'$parentaddr(2)
			winctl dot=addr
			winctl show
		}
	}
}}

fn validatepick {@ {
	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}
	}

	if (~ $dot *''$nl''*) {
		echo_s >[1=2] $progname: pick: newline not allowed
		exit 1
	}

	if (~ $dot '') {
		echo_s >[1=2] $progname: pick: nil dot
		exit 1
	}

	exit 0
}}

fn pick {@ {
	if (! validatepick)
		exit 1

	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}

		oldlinecol = `$fs{winlinecolumn}
	}

	currentbody = $tmpdir/currentbody
	winid = $filterwinid {
		winread body >$currentbody
	}

	off = `$fs{sed $oldlinecol(1)q <$currentbody |grep -v '*'$dot |wc -l}

	newbody = $tmpdir/newbody
	<$currentbody >$newbody {
		grep '*'$dot
	}

	if (! cmp -s $currentbody $newbody) {
		winid = $filterwinid {
			oldname = `{winname}

			winctl name $newbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			line = `{echo_s $oldlinecol(1) - $off |bc}
			col1 = `{echo_s $oldlinecol(2) - 1 |bc}
			col2 = `{echo_s $oldlinecol(4) - 1 |bc}
			winaddr $line'-#0+#'$col1','$line'-#0+#'$col2
			winctl dot=addr
			winctl show
		}
	}
}}

fn skip {@ {
	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}

		oldlinecol = `$fs{winlinecolumn}
	}

	if (~ $dot *''$nl''*) {
		echo_s >[1=2] $progname: skip: newline not allowed
		exit 1
	}

	if (~ $dot '') {
		echo_s >[1=2] $progname: skip: nil dot
		exit 1
	}

	currentbody = $tmpdir/currentbody
	winid = $filterwinid {
		winread body >$currentbody
	}

	newline = `$fs{sed $oldlinecol(1)q <$currentbody |grep -v '*'$dot |wc -l}

	newbody = $tmpdir/newbody
	<$currentbody >$newbody {
		grep -v '*'$dot
	}

	if (! cmp -s $currentbody $newbody) {
		winid = $filterwinid {
			oldname = `{winname}

			winctl name $newbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			winaddr $newline'-#0'
			winctl dot=addr
			winctl show
		}
	}
}}

winid = $parentwinid {
	winwordaddr >/dev/null
	dot = `''{winread xdata}
}

ctl = `$fs{9p read acme/new/ctl}
filterwinid = $ctl($acmeindexid)

winid = $filterwinid {
	winctl name `{nextwinname `{pwd} filter}
	echo -n 'Get Pick Skip ' |winwrite tag
}

get

# Don't run Pick automatically if it's not safe.
#
if (validatepick >[2]/dev/null)
	pick

winid = $filterwinid {
	wineventloop
}

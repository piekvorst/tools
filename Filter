#!/usr/bin/env rc
ifs = '
'

. 9.rc
. $PLAN9/lib/acme.rc
. lib.rc
. libacme.rc

nl = '
'

fs = '
	 '

progname = `{basename $0}

tmpdir = /tmp/$progname$pid
mkdir -p $tmpdir

parentbody = $tmpdir/parentbody

parentwinid = $winid
winid = '' # be explicit in multi-window context

currentlines = $tmpdir/currentlines
touch $currentlines

fn sigexit {rm -r $tmpdir}

fn event {
	# $1 - c1 origin of event
	# $2 - c2 type of action
	# $3 - q0 beginning of selection
	# $4 - q1 end of selection
	# $5 - eq0 beginning of expanded selection
	# $6 - eq1 end of expanded selection
	# $7 - flag
	# $8 - nr number of runes in $9
	# $9 - text
	# $10 - chorded argument
	# $11 - origin of chorded argument

	switch($1$2){
	case E*	# write to body or tag
	case F*	# generated by ourselves; ignore
	case K*	# type away we do not care
	case Mi	# mouse: text inserted in tag
	case MI	# mouse: text inserted in body
	case Md	# mouse: text deleted from tag
	case MD	# mouse: text deleted from body

	case Mx MX	# button 2 in tag or body
		switch ($9) {
		case Get
			get

		case Pick
			pick

		case Skip
			skip

		case *
			winid = $filterwinid {
				winwriteevent $*
			}
		}

	case Ml ML	# button 3 in tag or body
		winid = $filterwinid {
			winwriteevent $*
		}
	}
}

fn get {@ {
	currentbody = $tmpdir/currentbody

	winid = $filterwinid {
		linecol = `$fs{winlinecolumn}
	}

	parentline = `{sed -n $linecol(1)p $currentlines}
	winid = $parentwinid {
		if (~ $linecol(1) $linecol(3) && ! ~ $linecol(2) $linecol(4))
			parentaddr = `$fs{acmeaddr $parentline'-#0+#'$linecol(2)'-#1',$parentline'-#0+#'$linecol(4)'-#1'}
		if not
			parentaddr = `$fs{acmeaddr $parentline'-#0+#'$linecol(2)'-#1'}
	}

	# FIXME: move this to acmeaddr
	#
	if (~ $#parentaddr 1)
		parentaddr = ($parentaddr $parentaddr)

	winid = $filterwinid {
		winread body >$currentbody
	}

	awk '{print NR}' $parentbody >$currentlines

	if (! cmp -s $currentbody $parentbody) {
		winid = $filterwinid {
			oldname = `{winname}
			winctl name $parentbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			winaddr '#'$parentaddr(1)',#'$parentaddr(2)
			winctl dot=addr
			winctl show
		}
	}
	if not {
		winid = $filterwinid {
			winctl del
		}
		winid = $parentwinid {
			winaddr '#'$parentaddr(1)',#'$parentaddr(2)
			winctl dot=addr
			winctl show
		}
	}
}}

fn validatepick {@ {
	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}
	}

	if (~ $dot *''$nl''*) {
		echo_s >[1=2] $progname: pick: newline not allowed
		exit 1
	}

	if (~ $dot '') {
		echo_s >[1=2] $progname: pick: nil dot
		exit 1
	}

	exit 0
}}

fn pick {@ {
	if (! validatepick)
		exit 1

	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}

		oldlinecol = `$fs{winlinecolumn}
	}

	currentbody = $tmpdir/currentbody
	winid = $filterwinid {
		winread body >$currentbody
	}

	off = `$fs{sed $oldlinecol(1)q <$currentbody |grep -v '*'$dot |wc -l}

	newbody = $tmpdir/newbody
	<$currentbody >$newbody {
		grep '*'$dot
	}

	awk -v dot=$dot '
		NR == FNR {
			numbers[FNR] = $0
			next
		}
		$0 ~ dot {
			print numbers[FNR]
		}
	' $currentlines $currentbody >$currentlines$pid
	mv $currentlines$pid $currentlines

	if (! cmp -s $currentbody $newbody) {
		winid = $filterwinid {
			oldname = `{winname}

			winctl name $newbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			line = `{echo_s $oldlinecol(1) - $off |bc}
			col1 = `{echo_s $oldlinecol(2) - 1 |bc}
			col2 = `{echo_s $oldlinecol(4) - 1 |bc}
			winaddr $line'-#0+#'$col1','$line'-#0+#'$col2
			winctl dot=addr
			winctl show
		}
	}
}}

fn skip {@ {
	winid = $filterwinid {
		winwordaddr >/dev/null
		dot = `''{winread xdata}

		oldlinecol = `$fs{winlinecolumn}
	}

	if (~ $dot *''$nl''*) {
		echo_s >[1=2] $progname: skip: newline not allowed
		exit 1
	}

	if (~ $dot '') {
		echo_s >[1=2] $progname: skip: nil dot
		exit 1
	}

	currentbody = $tmpdir/currentbody
	winid = $filterwinid {
		winread body >$currentbody
	}

	newline = `$fs{sed $oldlinecol(1)q <$currentbody |grep -v '*'$dot |wc -l}

	newbody = $tmpdir/newbody
	<$currentbody >$newbody {
		grep -v '*'$dot
	}

	awk -v dot=$dot '
		NR == FNR {
			numbers[FNR] = $0
			next
		}
		$0 !~ dot {
			print numbers[FNR]
		}
	' $currentlines $currentbody >$currentlines$pid
	mv $currentlines$pid $currentlines

	if (! cmp -s $currentbody $newbody) {
		winid = $filterwinid {
			oldname = `{winname}

			winctl name $newbody
			winctl clean
			winctl get
			winctl name $oldname
			winctl clean

			winaddr $newline'-#0'
			winctl dot=addr
			winctl show
		}
	}
}}

ctl = `$fs{9p read acme/new/ctl}
filterwinid = $ctl($acmeindexid)

winid = $filterwinid {
	winctl name `{nextwinname `{pwd} filter}
	echo -n 'Get Pick Skip ' |winwrite tag
}

winid = $parentwinid {
	winread body >$parentbody
	parentaddr = `$fs{acmeaddr}
}

# FIXME: move this to acmeaddr
#
if (~ $#parentaddr 1)
	parentaddr = ($parentaddr $parentaddr)

winid = $filterwinid {
	oldname = `{winname}
	winctl name $parentbody
	winctl clean
	winctl get
	winctl name $oldname
	winctl clean
}

awk '{print NR}' $parentbody >$currentlines

# If arguments are provided, Filter sets the dot to the first match in
# file. If not provided or don't match anything, Filter inherits the
# parent's dot.
#
winid = $filterwinid {
	if (! {! ~ $"* '' && acmeaddr '0+/'`{samescape $"*}'/' >/dev/null >[2=1]})
		winaddr '#'$parentaddr(1)',#'$parentaddr(2)

	winctl dot=addr
	winctl show
}

# Don't run Pick automatically if it's not safe (e.g. unsafe
# parent dot).
#
if (validatepick >[2]/dev/null)
	pick

winid = $filterwinid {
	wineventloop
}

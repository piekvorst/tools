#!/usr/bin/env rc
ifs = '
'

. 9.rc
. $PLAN9/lib/acme.rc
. lib.rc
. libacme.rc

fs = '
	 '

ctlfs = '
	 '

tmpdir = /tmp/`{basename $0}$pid
mkdir -p $tmpdir

tmpsrc = $tmpdir/src

stickylines = 0

off = 1
overlap = 10
len = 110

maxlen = 0

fn sigexit {rm -r $tmpdir}

fn event {
	# $1 - c1 origin of event
	# $2 - c2 type of action
	# $3 - q0 beginning of selection
	# $4 - q1 end of selection
	# $5 - eq0 beginning of expanded selection
	# $6 - eq1 end of expanded selection
	# $7 - flag
	# $8 - nr number of runes in $9
	# $9 - text
	# $10 - chorded argument
	# $11 - origin of chorded argument

	switch($1$2){
	case E*	# write to body or tag
	case F*	# generated by ourselves; ignore
	case K*	# type away we do not care
	case Mi	# mouse: text inserted in tag
	case MI	# mouse: text inserted in body
	case Md	# mouse: text deleted from tag
	case MD	# mouse: text deleted from body

	case Mx MX	# button 2 in tag or body
		switch ($9) {
		case Left
			off = `{echo $off + $overlap - $len |bc}
			if (~ $off -* 0)
				off = 1
			write

		case Right
			off = `{echo $off + $len - $overlap |bc}
			if (test $off -gt `{echo $maxlen + 1 |bc})
				off = `{echo $maxlen + 1 |bc}
			write

		case Len-
			len = `{echo $len - 10 |bc}
			if (test $len -lt `{echo $overlap '*' 2 |bc})
				len = `{echo $overlap '*' 2 |bc}
			write

		case Len+
			if (test $len -lt $maxlen)
				len = `{echo $len + 10 |bc}
			write

		case *
			winwriteevent $*
		}

	case Ml ML	# button 3 in tag or body
		winwriteevent $*
	}
}

fn write {@ {
	newbody = $tmpdir/newbody
	currentbody = $tmpdir/currentbody

	<$tmpsrc >$newbody {
		un9 awk -v off=$off -v len=$len '{print substr($0, off, len)}'
	}

	winread body >$currentbody
	if (! cmp -s $currentbody $newbody) {
		oldname = `{winname}
		linecol = `$fs{winlinecolumn}

		winctl name $newbody
		winctl clean
		winctl get
		winctl name $oldname
		winctl clean

		if (~ $linecol(1)$linecol(2) $linecol(3)$linecol(4))
			winaddr $linecol(1)'-#0'
		if not
			winaddr $linecol(1),$linecol(3)

		winctl dot=addr

		# Don't "show". Here, the viewport is more important than the
		# cursor position.
	}
}}

flagfmt = 'l lines,s,w'
if (! eval `''{getflags >[2=1] $*}) {
	usage
	exit usage
}

if (~ $flags '') {
	winctl addr=dot
	winread xdata >$tmpsrc
}
if not {
	cat >$tmpsrc
}

maxlen = `{cat $tmpsrc |un9 awk '{print length}' |sort -nr |sed 1q}
if (! ~ $maxlen '')
	maxlen = $maxlen
if not
	maxlen = 0

ctl = `$ctlfs{9p read acme/new/ctl}
winid = $ctl($acmeindexid)
winctl font `{fixfont}

winctl name `{nextwinname `{pwd} unwrap}
echo -n 'Len- Len+ Left Right ' |winwrite tag
write

if (! ~ $flagw '')
	echo $winid

wineventloop

#!/usr/bin/env rc
ifs = '
'

# cal/dow [1-7]

. 9.rc

months = (jan feb mar apr may jun jul aug sep oct nov dec)

if (! ~ $1 [1-7]) {
	echo >[1=2] invalid syntax
	exit 1
}

for (y in `{ls -p $home |grep '^[0-9][0-9][0-9][0-9]$'}) {
	for (m in $months) {
		for (d in `{cal $m $y |sed -n '/[a-zA-Z]/!s/^(..).(..).(..).(..).(..).(..).(..)$/\'$1'/p' |sed 's/[^0-9]//'}) {
			f = $home/$y/$m/$d
			if (test -e $f)
				echo $f
		}
	}
}

exit 0
